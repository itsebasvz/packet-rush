{
  "name": "packet-rush",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/validate-content.mjs && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:db": "node --env-file-if-exists=.env.local scripts/test-db.mjs",
    "test:load": "node --env-file-if-exists=.env.local scripts/load-test.mjs",
    "test:e2e": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test",
    "supabase": "supabase"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.0",
    "next": "16.4.2",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "22.20.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "supabase": "2.116.0",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3"
  }
}
